# Set a Supabase transaction pooler URI in Vercel, or use the integration's POSTGRES_URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional. Use on a protected deployment with a team-approved Gemini credential.
# CAMPUSFLOW_ENABLE_HOSTED_MODEL=1
#GEMINI_API_KEY=
# CAMPUSFLOW_GEMINI_MODEL=
